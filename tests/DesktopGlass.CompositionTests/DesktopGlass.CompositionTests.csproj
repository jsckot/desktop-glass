<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>CompositionTests</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>../../src/DesktopGlass.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DesktopGlass.Core/DesktopGlass.Core.csproj" />
    <Compile Include="../../src/DesktopGlass.App/*.cs" Link="App/%(Filename)%(Extension)" />
    <Compile Include="../../src/DesktopGlass.App/UI/*.cs" Link="UI/%(Filename)%(Extension)" />
    <Compile Include="../../src/DesktopGlass.App/Windows/*.cs" Link="Windows/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- 自包含验证与交付程序使用相同 WPF/.NET 运行库，避免只在 SDK 自带运行库上通过。 -->
  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App" RuntimeFrameworkVersion="10.0.13" />
  </ItemGroup>
</Project>
